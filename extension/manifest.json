{
  "manifest_version": 2,
  "name": "Canary \u2014 file to matter",
  "version": "1.5.42",
  "description": "File mail to a matter; compose from a matter with merge and attachments; apply the Canary message tag.",
  "author": "Canary",
  "applications": {
    "gecko": {
      "id": "canary-file@canarylegal.co.uk",
      "strict_min_version": "128.0",
      "update_url": "https://github.com/canarylegal/canary-thunderbird/releases/latest/download/updates.json"
    }
  },
  "protocol_handlers": [
    {
      "protocol": "ext+canary",
      "name": "Canary \u2014 open filed e-mail",
      "uriTemplate": "/open-handoff.html#%s"
    }
  ],
  "background": {
    "persistent": true,
    "scripts": [
      "tag-apply.js",
      "canary-windows.js",
      "canary-shared.js",
      "compose-store.js",
      "compose-apply.js",
      "message-view-cache.js",
      "compose-prefill.js",
      "compose-send.js",
      "compose-auto-open.js",
      "compose-compose-action.js",
      "filing-menu.js",
      "pending-eml-open.js",
      "site-permissions.js",
      "background.js"
    ]
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "64": "icons/icon64.png",
    "128": "icons/icon128.png"
  },
  "browser_action": {
    "default_title": "Canary \u2014 file mail",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "compose_action": {
    "default_title": "Canary \u2014 matter & attach",
    "default_popup": "compose-panel/panel.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "message_display_action": {
    "default_title": "Canary \u2014 file",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "permissions": [
    "storage",
    "menus",
    "tabs",
    "accountsRead",
    "messagesRead",
    "messagesUpdate",
    "messagesTags",
    "messagesTagsList",
    "compose",
    "notifications"
  ],
  "optional_permissions": [
    "https://*/*"
  ]
}
